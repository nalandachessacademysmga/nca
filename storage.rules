rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is authenticated.
    function isAuthenticated() {
        return request.auth != null;
    }

    // Get the user's role from their document.
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Check if the user has an admin role.
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    // Check if the user has an admin or editor role.
    function isEditorOrAdmin() {
      let userRole = getUserRole();
      return isAuthenticated() && (userRole == 'admin' || userRole == 'editor');
    }

    // -------------------------------------------------------------
    // Rules for the 'users' collection
    // -------------------------------------------------------------
    match /users/{userId} {
        // A user can read their own profile, but only an admin can read others.
        allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        
        // Only an admin can delete a user's profile.
        allow delete: if isAdmin();
        
        // A user can create their own profile, but cannot set their own role.
        allow create: if isAuthenticated()
                      && request.auth.uid == userId
                      && request.resource.data.keys().hasAll(['name', 'email', 'role'])
                      && request.resource.data.keys().hasOnly(['name', 'email', 'role'])
                      // Prevent a user from self-assigning a privileged role.
                      && request.resource.data.role == 'player';
        
        // A user can update their own profile, but cannot change their role.
        // Admins can update any user's profile, including their role.
        allow update: if isAuthenticated()
                      && (request.auth.uid == userId && request.resource.data.role == resource.data.role)
                      || isAdmin();
    }
    
    // -------------------------------------------------------------
    // Rules for the public 'achievements' collection
    // -------------------------------------------------------------
    match /artifacts/{appId}/public/data/achievements/{docId} {
        // Allow anyone (authenticated or not) to read the public achievements.
        allow read;

        // Only editors and admins can create, update, or delete achievements.
        allow write: if isEditorOrAdmin();
        // A more specific rule for delete, only allowing admins.
        allow delete: if isAdmin();
    }
  }
}